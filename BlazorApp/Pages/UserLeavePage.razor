@code {
    [Parameter]
    public int UserId { get; set; }

    private bool IsLoading { get; set; } = true;
    private User UserInfo { get; set; } = new User();
    private List<LeaveRequest> UserLeaves { get; set; } = new List<LeaveRequest>();

    private int ApprovedCount { get; set; }
    private int PendingCount { get; set; }

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;

        var userIdString = await JS.InvokeAsync<string>("localStorage.getItem", "userId");

        if (string.IsNullOrEmpty(userIdString) || !int.TryParse(userIdString, out var parsedUserId))
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        UserId = parsedUserId;

        UserInfo = await UserService.GetUserByIdAsync(UserId);
        UserLeaves = (await LeaveRequestService.GetUserLeaveRequestsAsync(UserId)).ToList();

        ApprovedCount = UserLeaves.Count(l => l.Status == "Approved");
        PendingCount = UserLeaves.Count(l => l.Status == "Pending");

        IsLoading = false;
    }

    private void NavigateToCreate()
    {
        NavigationManager.NavigateTo("/create-leave");
    }

    private async Task LoadAllLeaves()
    {
        UserLeaves = (await LeaveRequestService.GetUserLeaveRequestsAsync(UserId)).ToList();
        StateHasChanged();
    }

    private async Task LoadPendingLeaves()
    {
        UserLeaves = (await LeaveRequestService.GetUserLeaveRequestsAsync(UserId))
            .Where(l => l.Status == "Pending").ToList();
        StateHasChanged();
    }

    private async Task LoadApprovedLeaves()
    {
        UserLeaves = (await LeaveRequestService.GetUserLeaveRequestsAsync(UserId))
            .Where(l => l.Status == "Approved").ToList();
        StateHasChanged();
    }

    private LoginModel loginModel = new LoginModel();
    private string errorMessage = string.Empty;

    //naya


    private class LoginResponse
    {
        public string Token { get; set; }
        public int UserId { get; set; }
        public string Username { get; set; }
        public string Email { get; set; }
        public string Role { get; set; }
    }
    private async Task HandleLogin()
    {
        errorMessage = string.Empty;

        var response = await Http.PostAsJsonAsync("http://localhost:5051/api/user/login", loginModel);

        if (response.IsSuccessStatusCode)
        {
            var responseBody = await response.Content.ReadFromJsonAsync<LoginResponse>();

            if (responseBody == null)
            {
                errorMessage = "Invalid server response.";
                return;
            }

            await LocalStorage.SetItemAsync("auth_token", responseBody.Token);
            await LocalStorage.SetItemAsync("userId", responseBody.UserId);
            await LocalStorage.SetItemAsync("username", responseBody.Username);
            await LocalStorage.SetItemAsync("email", responseBody.Email);
            await LocalStorage.SetItemAsync("role", responseBody.Role);

            Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", responseBody.Token);

            if (responseBody.Role == "Admin")
            {
                NavigationManager.NavigateTo("/admin-leaves");
            }
            else
            {
                NavigationManager.NavigateTo($"/user-leaves/{responseBody.UserId}");
            }
        }
        else
        {
            var responseContent = await response.Content.ReadAsStringAsync();
            errorMessage = $"Login failed: {responseContent}".Trim('"');
        }
    }


    private class LoginModel
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Invalid email format.")]
        public string Email { get; set; }

        [Required(ErrorMessage = "Password is required.")]
        [MinLength(6, ErrorMessage = "Password must be at least 6 characters.")]
        public string Password { get; set; }
    }
}


 


