    private bool IsLoading = true;

    private string ErrorMessage;

    private string Username = "Username Here";

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;

        try
        {
            UserLeaves = await LeaveRequestService.GetUserLeaveRequestsAsync(UserId);
            // If you have a way to fetch the user's name, do it here
            Username = (await UserService.GetUserByIdAsync(UserId)).Username;

        }
        catch (Exception ex)
        {
            ErrorMessage = $"Unable to fetch leaves for this user: {ex.Message}.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ViewPending()
    {
        UserLeaves = UserLeaves.Where(l => l.Status == "Pending").ToList();
    }

    private void ViewApproved()
    {
