@* @page "/user-leaves"
@using BlazorApp.Interface
@using Shared.Entities;
@inject ILeaveRequestService LeaveRequestService
@inject IUserService UserService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<h3>My Leave Dashboard</h3>

@if (IsLoading)
{
    <p>Loading...</p>
}
else
{
    <div class="card p-3 mb-4">
        <h5>Leave Balance</h5>
        <p><strong>Allowed Leaves:</strong> @UserInfo.AllowedLeavesPerYear</p>
        <p><strong>Leaves Taken:</strong> @UserInfo.LeavesTakenThisYear</p>
    </div>

    <div class="card p-3 mb-4">
        <h5>Request New Leave</h5>
        <EditForm Model="NewLeave" OnValidSubmit="SubmitLeaveRequest">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-2">
                <label>Leave Type:</label>
                <InputSelect @bind-Value="NewLeave.LeaveTypeId" class="form-control">
                    <option value="">-- Select Leave Type --</option>
                    <option value="Sick"> Sick</option>
                    <option value="Causal">Casual</option>
                    <option value="Emergency">Emergency</option>
                </InputSelect>
            </div>



            <div class="mb-2">
                <label>Start Date:</label>
                <InputDate @bind-Value="NewLeave.StartDate" class="form-control" />
            </div>

            <div class="mb-2">
                <label>End Date:</label>
                <InputDate @bind-Value="NewLeave.EndDate" class="form-control" />
            </div>

            <div class="mb-2">
                <label>Reason:</label>
                <InputText @bind-Value="NewLeave.Reason" class="form-control" />
            </div>

            <button class="btn btn-primary" type="submit">Submit Request</button>
        </EditForm>
    </div>

    <div class="card p-3">
        <h5>My Leave Requests</h5>
        @if (LeaveRequests.Any())
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Start</th>
                        <th>End</th>
                        <th>Status</th>
                        <th>Reason</th>
                        <th>Admin Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var leave in LeaveRequests)
                    {
                        <tr>
                            <td>@leave.StartDate.ToShortDateString()</td>
                            <td>@leave.EndDate.ToShortDateString()</td>
                            <td>@leave.Status</td>
                            <td>@leave.Reason</td>
                            <td>@leave.AdminRemarks</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>No leave requests yet.</p>
        }
    </div>
}

@code {
    private List<LeaveRequest> LeaveRequests = new();
    private LeaveRequest NewLeave = new();
    private User UserInfo = new();
    private bool IsLoading = true;
    private List<LeaveType> LeaveTypes = new();

    private int UserId = 1; // Replace with actual logged-in user ID after authentication

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;

        UserInfo = await UserService.GetUserByIdAsync(UserId);
        LeaveRequests = (await LeaveRequestService.GetUserLeaveRequestsAsync(UserId)).ToList();
        LeaveTypes = await LeaveRequestService.GetLeaveTypesAsync(); // Add this service method

        NewLeave = new LeaveRequest
            {
                UserId = UserId,
                Username = UserInfo.Username ?? "",
                StartDate = DateTime.Now,       
                EndDate = DateTime.Now.AddDays(1)
            };

        IsLoading = false;
    }

    private async Task SubmitLeaveRequest()
    {
        // Validate leave duration

        int requestedDays = (NewLeave.EndDate - NewLeave.StartDate).Days + 1;
        int availableLeaves = UserInfo.AllowedLeavesPerYear - UserInfo.LeavesTakenThisYear;

        if (requestedDays <= 0)
        {
            await JS.InvokeVoidAsync("alert", "End date must be after start date.");
            return;
        }

        if (requestedDays > availableLeaves)
        {
            await JS.InvokeVoidAsync("alert", $"You only have {availableLeaves} leaves left.");
            return;
        }
        var newLeaveDto = new LeaveRequestDto
            {
                UserId = NewLeave.UserId,
                LeaveTypeId = NewLeave.LeaveTypeId,
                StartDate = NewLeave.StartDate,
                EndDate = NewLeave.EndDate,
                Reason = NewLeave.Reason,
                Status = NewLeave.Status
            };

        await LeaveRequestService.CreateLeaveRequestAsync(newLeaveDto);
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
        // await LeaveRequestService.CreateLeaveRequestAsync(NewLeave);
        // NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }
}
