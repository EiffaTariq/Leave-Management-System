@page "/login"

@using BlazorApp.Interface
@using System.Net.Http.Headers
@using System.ComponentModel.DataAnnotations
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ILocalStorageService LocalStorage

<style>
    body {
        margin: 0;
        font-family: 'Segoe UI', sans-serif;
    }

    .light-blue-background {
        background-color: #D0E8FB;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: 60px;
        padding-bottom: 60px;
    }

    h3 {
        color: #333;
        margin-bottom: 20px;
    }

    .card {
        background-color: #fff;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
        max-width: 420px;
        width: 100%;
        transition: all 0.3s ease;
        text-align: left;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        }

    label {
        display: block;
        font-weight: 600;
        margin-bottom: 6px;
        color: #333;
    }

    input.form-control {
        width: 100%;
        padding: 10px;
        font-size: 1rem;
        border: 1px solid #ccc;
        border-radius: 6px;
        margin-bottom: 15px;
        transition: border-color 0.3s ease;
    }

        input.form-control:focus {
            outline: none;
            border-color: #7cbce6;
        }

    .light-brown-button {
        background-color: #D2B48C;
        color: #fff;
        border: none;
        padding: 12px;
        font-size: 1rem;
        border-radius: 6px;
        cursor: pointer;
        width: 100%;
        font-weight: 600;
        transition: background-color 0.3s ease;
    }

        .light-brown-button:hover {
            background-color: #C19A6B;
        }

    .alert {
        margin-top: 15px;
        padding: 10px;
        color: #721c24;
        background-color: #f8d7da;
        border: 1px solid #f5c6cb;
        border-radius: 4px;
    }

    .text-center {
        text-align: center;
        margin-top: 15px;
    }

        .text-center a {
            color: #007bff;
            text-decoration: none;
        }

            .text-center a:hover {
                text-decoration: underline;
            }

    footer {
        margin-top: auto;
        text-align: center;
        padding: 20px 0;
        background-color: #f5f5f5;
        color: #666;
        font-size: 0.9rem;
        border-top: 1px solid #ddd;
        width: 100%;
    }
</style>

<div class="light-blue-background">
    <h3>Login</h3>

    <div class="card">
        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div>
                <label for="email">Email</label>
                <InputText id="email" class="form-control" @bind-Value="loginModel.Email" />
            </div>

            <div>
                <label for="password">Password</label>
                <InputText id="password" type="password" class="form-control" @bind-Value="loginModel.Password" />
            </div>

            <button type="submit" class="light-brown-button">Login</button>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert">@errorMessage</div>
            }

            <div class="text-center">
                <p>Don't have an account? <a href="/register">Register here</a></p>
            </div>
        </EditForm>
    </div>

    <footer>
        <p>&copy; @DateTime.Now.Year Leave Management System</p>
    </footer>
</div>

@code {
    private LoginModel loginModel = new LoginModel();
    private string errorMessage = string.Empty;

    private async Task HandleLogin()
    {
        errorMessage = string.Empty;

        var response = await Http.PostAsJsonAsync("http://localhost:5051/api/user/login", loginModel);

        if (response.IsSuccessStatusCode)
        {
            var responseBody = await response.Content.ReadFromJsonAsync<LoginResponse>();

            if (responseBody == null)
            {
                errorMessage = "Invalid server response.";
                return;
            }

            await LocalStorage.SetItemAsync("auth_token", responseBody.Token);
            await LocalStorage.SetItemAsync("userId", responseBody.UserId);
            await LocalStorage.SetItemAsync("username", responseBody.Username);
            await LocalStorage.SetItemAsync("email", responseBody.Email);
            await LocalStorage.SetItemAsync("role", responseBody.Role);

            Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", responseBody.Token);

            if (responseBody.Role == "Admin")
            {
                Navigation.NavigateTo("/admin-leaves");
            }
            else
            {
                Navigation.NavigateTo($"/user-leaves/{responseBody.UserId}");
            }
        }
        else
        {
            var responseContent = await response.Content.ReadAsStringAsync();
            errorMessage = $"Login failed: {responseContent}".Trim('"');
        }
    }

    private class LoginModel
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Invalid email format.")]
        public string Email { get; set; }

        [Required(ErrorMessage = "Password is required.")]
        [MinLength(6, ErrorMessage = "Password must be at least 6 characters.")]
        public string Password { get; set; }
    }

    private class LoginResponse
    {
        public string Token { get; set; }
        public int UserId { get; set; }
        public string Username { get; set; }
        public string Email { get; set; }
        public string Role { get; set; }
    }
}
