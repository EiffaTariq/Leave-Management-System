@page "/create-leave"

@using Shared.Entities
@using BlazorApp.Interface
@inject ILeaveRequestService LeaveRequestService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
<nav>

</nav>
<div class="light-blue-background">
    <div class="form-card">
        <h3>Create a Leave Request</h3>

        <EditForm Model="@leaveDto" OnValidSubmit="@HandleValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group">
                <label>Start Date</label>
                <InputDate class="form-control" @bind-Value="@leaveDto.StartDate" />
            </div>

            <div class="form-group">
                <label>End Date</label>
                <InputDate class="form-control" @bind-Value="@leaveDto.EndDate" />
            </div>

            <div class="form-group">
                <label>Reason</label>
                <InputText class="form-control" @bind-Value="@leaveDto.Reason" />
            </div>

            <button type="submit" class="btn-submit" disabled="@isSubmitting">Submit</button>
        </EditForm>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="@($"alert {(isSuccess ? "info" : "error")}")">
                @message
            </div>
        }
    </div>
</div>

<style>
    .light-blue-background {
        background-color: #D0E8FB;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
    }

    .form-card {
        background-color: #fff;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.1);
        width: 100%;
        max-width: 500px;
    }

    h3 {
        text-align: center;
        margin-bottom: 24px;
        font-size: 24px;
        color: #333;
    }

    .form-group {
        margin-bottom: 20px;
    }

    label {
        display: block;
        font-weight: 600;
        margin-bottom: 6px;
        color: #444;
    }

    .form-control {
        width: 100%;
        padding: 10px;
        font-size: 1rem;
        border: 1px solid #ccc;
        border-radius: 6px;
        transition: border-color 0.3s;
    }

        .form-control:focus {
            border-color: #6cb2eb;
            outline: none;
        }

    .btn-submit {
        width: 100%;
        background-color: #3b82f6;
        color: #fff;
        padding: 12px;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.3s;
    }

        .btn-submit:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

        .btn-submit:hover:not(:disabled) {
            background-color: #2563eb;
        }

    .alert {
        margin-top: 20px;
        padding: 12px;
        border-radius: 6px;
        font-weight: 500;
        text-align: center;
    }

        .alert.info {
            background-color: #d1fae5;
            color: #065f46;
            border: 1px solid #10b981;
        }

        .alert.error {
            background-color: #fee2e2;
            color: #991b1b;
            border: 1px solid #f87171;
        }
</style>

@code {
    private string message = "";
    private bool isSuccess = false;
    private bool isSubmitting = false;

    private LeaveRequestDto leaveDto = new()
        {
            StartDate = DateTime.UtcNow,
            EndDate = DateTime.UtcNow,
            Reason = ""
        };

    protected override async Task OnInitializedAsync()
    {
        var userIdString = await JS.InvokeAsync<string>("localStorage.getItem", "userId");

        if (string.IsNullOrEmpty(userIdString) || !int.TryParse(userIdString, out var parsedUserId))
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        leaveDto.UserId = parsedUserId;
    }

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;
        message = "";

        var response = await LeaveRequestService.CreateLeaveRequestAsync(leaveDto);

        if (response.Success)
        {
            isSuccess = true;
            message = response.Message;
            NavigationManager.NavigateTo("/leave-confirmation");
        }
        else
        {
            isSuccess = false;
            message = response.Message;
        }

        isSubmitting = false;
    }
}

