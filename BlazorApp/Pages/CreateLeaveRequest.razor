 @page "/create-leave"

@using BlazorApp.Services
@using Shared.Entities
@using BlazorApp.Interface
@inject ILeaveRequestService LeaveRequestService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<h3>Create a new leave</h3>

<EditForm Model="@leaveDto" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />

    <ValidationSummary />

    <div class="mb-3">
        <label>Start Date</label>
        <InputDate @bind-Value="leaveDto.StartDate" class="form-control" />
    </div>

    <div class="mb-3">
        <label>End Date</label>
        <InputDate @bind-Value="leaveDto.EndDate" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Reasons</label>
        <InputTextArea @bind-Value="leaveDto.Reason" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Leave Type</label>
        <InputSelect @bind-Value="leaveDto.LeaveTypeId">
            <option value="">Select</option>
            <option value="1">Sick</option>
            <option value="2">Casual</option>
            <option value="2">Emergency</option>
        </InputSelect>
    </div>

    <button class="btn btn-primary" type="submit">Submit</button>
</EditForm>

@code {
    private LeaveRequestDto leaveDto = new()
        {
            UserId = 0,
            StartDate = DateTime.Today,
            EndDate = DateTime.Today
        };

    private bool isSubmitting = false;

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;

        var userIdString = await JS.InvokeAsync<string>("localStorage.getItem", "userId");

        if (string.IsNullOrEmpty(userIdString) ||
            !int.TryParse(userIdString, out var parsedUserId))
        {
            // Redirect to login if not authenticated
            NavigationManager.NavigateTo("/login");

            return;
        }

        leaveDto.UserId = parsedUserId;

        var response = await LeaveRequestService.CreateLeaveRequestAsync(leaveDto);

        isSubmitting = false;

        if (response.Success)
        {
            // Redirect after successful submission
            NavigationManager.NavigateTo($"/user-leaves/{parsedUserId}");

        }
        else
        {
            // Handle submission failure
            Console.WriteLine("Failed to submit leave: " + response.Message);
        }
    }
}
