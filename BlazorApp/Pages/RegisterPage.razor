 @page "/register"

@using BlazorApp.Services
@using Shared.Entities
@using BlazorApp.Interface
@inject IUserService UserService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@using System.Net.Http.Headers
@using System.ComponentModel.DataAnnotations
@inject HttpClient Http
@inject ILocalStorageService LocalStorage

<style>
    body {
        margin: 0;
        font-family: 'Segoe UI', sans-serif;
    }

    .light-blue-background {
        background-color: #e6f3fb;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: 50px;
        padding-bottom: 50px;
    }

    h3 {
        color: #333;
        margin-bottom: 20px;
    }

    .card {
        background-color: #fff;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
        width: 100%;
        max-width: 420px;
        transition: all 0.3s ease-in-out;
    }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        }

    label {
        display: block;
        margin-bottom: 5px;
        font-weight: 600;
        color: #444;
    }

    input.form-control, select.form-control {
        width: 100%;
        padding: 10px;
        font-size: 1rem;
        border: 1px solid #ccc;
        border-radius: 6px;
        margin-bottom: 15px;
        transition: border-color 0.3s ease;
    }

        input.form-control:focus, select.form-control:focus {
            outline: none;
            border-color: #7cbce6;
        }

    .light-brown-button {
        background-color: #c9a66b;
        color: #fff;
        padding: 12px;
        border: none;
        border-radius: 6px;
        width: 100%;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

        .light-brown-button:hover {
            background-color: #b88a4a;
        }

    .alert {
        margin-top: 15px;
        padding: 10px;
        color: #721c24;
        background-color: #f8d7da;
        border: 1px solid #f5c6cb;
        border-radius: 4px;
    }

    .text-center {
        text-align: center;
        margin-top: 15px;
    }

        .text-center a {
            color: #007bff;
            text-decoration: none;
        }

            .text-center a:hover {
                text-decoration: underline;
            }

    footer {
        margin-top: auto;
        text-align: center;
        padding: 20px 0;
        background-color: #f5f5f5;
        color: #666;
        font-size: 0.9rem;
        border-top: 1px solid #ddd;
        width: 100%;
    }
</style>

<div class="light-blue-background">
    <h3>Create an Account</h3>

    <div class="card">
        <EditForm Model="@registerModel" OnValidSubmit="HandleRegister">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div>
                <label>Username</label>
                <InputText class="form-control" @bind-Value="registerModel.Username" />
            </div>

            <div>
                <label>Email</label>
                <InputText class="form-control" @bind-Value="registerModel.Email" />
            </div>

            <div>
                <label>Password</label>
                <InputText type="password" class="form-control" @bind-Value="registerModel.Password" />
            </div>

            <div>
                <label>Confirm Password</label>
                <InputText type="password" class="form-control" @bind-Value="registerModel.ConfirmPassword" />
            </div>

            <div>
                <label>Role</label>
                <InputSelect class="form-control" @bind-Value="registerModel.Role">
                    <option value="">-- Select Role --</option>
                    <option value="User">User</option>
                    <option value="Admin">Admin</option>
                </InputSelect>
            </div>

            <button type="submit" class="light-brown-button">Register</button>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert">@errorMessage</div>
            }

            <div class="text-center">
                <p>Already have an account? <a href="/login">Log in</a></p>
            </div>
        </EditForm>
    </div>

    <footer>
        &copy; @DateTime.Now.Year Your Application
    </footer>
</div>

@code {
    private RegisterModel registerModel = new RegisterModel();
    private string errorMessage;

    private async Task HandleRegister()
    {
        errorMessage = string.Empty;

        var response = await Http.PostAsJsonAsync("http://localhost:5051/api/user/Register", registerModel);

        if (response.IsSuccessStatusCode)
        {
            var responseBody = await response.Content.ReadFromJsonAsync<RegisterResponse>();

            if (responseBody == null)
            {
                errorMessage = "Invalid server response.";
                return;
            }

            await LocalStorage.SetItemAsync("auth_token", responseBody.Token);
            await LocalStorage.SetItemAsync("userId", responseBody.UserId);
            await LocalStorage.SetItemAsync("username", responseBody.Username);
            await LocalStorage.SetItemAsync("email", responseBody.Email);
            await LocalStorage.SetItemAsync("role", responseBody.Role);

            NavigationManager.NavigateTo("/login");
        }
        else
        {
            var responseContent = await response.Content.ReadFromJsonAsync<string>();
            errorMessage = $"Registration failed: {responseContent}".Trim('"');
        }
    }

    private class RegisterResponse
    {
        public string Token { get; set; }
        public int UserId { get; set; }
        public string Username { get; set; }
        public string Email { get; set; }
        public string Role { get; set; }
    }
}