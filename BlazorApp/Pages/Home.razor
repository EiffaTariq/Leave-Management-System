@page "/"

@using Microsoft.AspNetCore.Components.Web

<style>
    .serif-font {
        font-family: serif;
    }

    .light-blue-background {
        background-color: #D0E8FB;
        min-height: 100vh;
        padding-bottom: 60px;
        padding-top: 60px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .card {
        background: #ffffff;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 4px 14px rgb(0 0 0 / 0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgb(0 0 0 / 0.3);
        }

    footer {
        width: 100%;
        padding: 5px 0;
        background: #fff;
        border-top: 1px solid #ccc;
        margin-top: auto;
    }
</style>

<div class="light-blue-background">
    <div class="container text-center mt-5">
        <h2 class="mb-4 serif-font">Leave Management System</h2>
        <p class="lead mb-5">Manage and track your annual leave with ease.</p>

        <div class="row justify-content-center g-4">
            <div class="col-md-4 d-flex">
                <div class="card w-100 h-100 d-flex flex-column text-center">
                    <h5 class="card-title">Login</h5>
                    <p class="card-text">Already a user?<br>Go to Dashboard by logging in</p>
                    <a href="/login" class="btn btn-primary mt-4">Login</a>
                </div>
            </div>

            <div class="col-md-4 d-flex">
                <div class="card w-100 h-100 d-flex flex-column text-center">
                    <h5 class="card-title">Register</h5>
                    <p class="card-text">New user?<br> Register through here.</p>
                    <a href="/register" class="btn btn-success mt-4">Register</a>
                </div>
            </div>
        </div>
    </div>

    <footer class="text-center text-muted">
        <hr />
        <p>&copy; @DateTime.Now.Year Leave Management System</p>
    </footer>
</div>
