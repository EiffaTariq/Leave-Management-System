@code {
    private List<LeaveRequestDto> UserLeaves;
    private bool IsLoading = true;
    private string ErrorMessage;
    private string _currentFilter = "Pending";
    private int UserId;

    // Remarks dialog state
    private bool ShowRemarksDialog = false;
    private int ActionLeaveId;
    private bool IsApproving;
    private string AdminRemarks;

    protected override async Task OnInitializedAsync()
    {
        //var userIdString = await LocalStorage.GetItemAsync<string>("userId");
        var userIdString = await JS.InvokeAsync<string>("localStorage.getItem", "userId");

        if (string.IsNullOrEmpty(userIdString) || !int.TryParse(userIdString, out UserId))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadLeavesAsync(_currentFilter);
    }

    private async Task LoadLeavesAsync(string filter)
    {
        ErrorMessage = null;
        IsLoading = true;
        _currentFilter = filter;
        UserLeaves = new List<LeaveRequestDto>();

        try
        {
            if (filter == "Pending")
            {
                // UserLeaves = (LeaveRequestService.LoadPendingLeavesAsync()).ToList();
                LeaveRequestService.LoadPendingLeavesAsync();
            }
            else
            {
                //UserLeaves = (LeaveRequestService.LoadApprovedLeavesAsync()).ToList();
                LeaveRequestService.LoadApprovedLeavesAsync();
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error loading leaves: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // Show the remarks dialog when approve clicked
    private void OnApproveClicked(int leaveId)
    {
        ActionLeaveId = leaveId;
        IsApproving = true;
        AdminRemarks = string.Empty;
        ShowRemarksDialog = true;
    }

    // Show the remarks dialog when reject clicked
    private void OnRejectClicked(int leaveId)
    {
        ActionLeaveId = leaveId;
        IsApproving = false;
        AdminRemarks = string.Empty;
        ShowRemarksDialog = true;
    }

    private void CancelRemarks()
    {
        ShowRemarksDialog = false;
        AdminRemarks = string.Empty;
        ActionLeaveId = 0;
    }

    private async Task SubmitRemarks()
    {
        string newStatus = IsApproving ? "Approved" : "Rejected";

        try
        {
            await LeaveRequestService.UpdateLeaveStatusAsync(ActionLeaveId, newStatus, AdminRemarks);
            ShowRemarksDialog = false;
            AdminRemarks = string.Empty;
            await LoadLeavesAsync(_currentFilter);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error updating leave status: {ex.Message}";
        }
    }

    public class LeaveRequestDto
    {
        public int Id { get; set; }
        public int UserId { get; set; }
        public string Username { get; set; } // Ensure Username property exists to fix errors
        public DateTime StartDate { get; set; }
        public DateTime EndDate { get; set; }
        public string Reason { get; set; }
        public string Status { get; set; }
        public string AdminRemarks { get; set; } // Optionally display remarks somewhere if needed
    }
}  *@



