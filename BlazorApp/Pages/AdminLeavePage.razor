@page "/admin-leaves"
@using BlazorApp.Interface
@using Shared.Entities
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable

@inject ILeaveRequestService LeaveRequestService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<h2 class="page-title">Admin Leave Management</h2>
@if (message is not null)
{
    <p>@message</p>
}
@if (IsLoading)
{
    <p class="loading-text">Loading leaves...</p>
}
else
{
    <div class="table-container">
        <h4>Leave Requests Overview</h4>

        <table class="styled-table">
            <thead>
                <tr>
                    <th>User ID</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Reason</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var leave in UserLeaves)
                {
                    <tr>
                        <td>@leave.UserId</td>
                        <td>@leave.StartDate.ToString("yyyy-MM-dd")</td>
                        <td>@leave.EndDate.ToString("yyyy-MM-dd")</td>
                        <td>@leave.Reason</td>
                        <td>
                            <span class="badge @leave.Status.ToLower()">
                                @leave.Status
                            </span>
                        </td>
                        <td>
                            @if (leave.Status == "Pending")
                            {
                                <button class="btn success small" @onclick="() => OnApproveClicked(leave.LeaveId)">Approve</button>
                                <button class="btn danger small" @onclick="() => OnRejectClicked(leave.LeaveId)">Reject</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="quick-actions">
            <h4>Quick Filters</h4>
            <button class="btn warning" @onclick="LoadPendingLeaves">Pending</button>
            <button class="btn success" @onclick="LoadApprovedLeaves">Approved</button>
            <button class="btn danger" @onclick="LoadRejectedLeaves">Rejected</button>
        </div>
    </div>
}

@if (ShowRemarksDialog)
{
    <div class="remarks-dialog-overlay">
        <div class="remarks-dialog">
            <h4>@(IsApproving ? "Approve Leave" : "Reject Leave")</h4>
            <textarea @bind="AdminRemarks" rows="4" placeholder="Enter remarks (optional)"></textarea>
            <div class="dialog-actions">
                <button class="btn secondary" @onclick="CancelRemarks">Cancel</button>
                <button class="btn primary" @onclick="SubmitRemarks">Submit</button>
            </div>
        </div>
    </div>
}

<style>
    body {
        background-color: #e6f2fb;
        font-family: 'Segoe UI', sans-serif;
    }

    .page-title {
        text-align: center;
        margin: 30px 0;
        font-size: 26px;
        color: #333;
    }

    .table-container {
        max-width: 1000px;
        margin: 0 auto;
        background: #fff;
        padding: 20px 30px;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.08);
    }

    .styled-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 16px;
    }

        .styled-table th, .styled-table td {
            padding: 12px;
            border: 1px solid #ccc;
            text-align: center;
        }

        .styled-table th {
            background: #dbeafe;
            font-weight: bold;
        }

    .badge {
        padding: 6px 12px;
        border-radius: 12px;
        font-size: 0.85rem;
        font-weight: 600;
        color: white;
    }

        .badge.pending {
            background-color: #fbbf24;
            color: #333;
        }

        .badge.approved {
            background-color: #22c55e;
        }

        .badge.rejected {
            background-color: #ef4444;
        }

    .btn {
        padding: 8px 14px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        margin: 4px;
        color: white;
        transition: 0.3s ease;
    }

        .btn.small {
            padding: 6px 10px;
            font-size: 0.85rem;
        }

        .btn.success {
            background-color: #22c55e;
        }

        .btn.danger {
            background-color: #ef4444;
        }

        .btn.warning {
            background-color: #f59e0b;
        }

        .btn.secondary {
            background-color: #e0e7ff;
            color: #4f46e5;
        }

        .btn.primary {
            background: linear-gradient(135deg, #6366f1, #06b6d4);
        }

        .btn:hover {
            opacity: 0.9;
        }

    .quick-actions {
        margin-top: 30px;
        padding: 20px;
        background: #f0f9ff;
        border-radius: 12px;
        text-align: center;
    }

    .remarks-dialog-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.4);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 999;
    }

    .remarks-dialog {
        background: white;
        padding: 24px;
        width: 90%;
        max-width: 400px;
        border-radius: 12px;
        box-shadow: 0 0 15px rgba(0,0,0,0.3);
    }

        .remarks-dialog textarea {
            width: 100%;
            padding: 10px;
            font-size: 1rem;
            border-radius: 6px;
            border: 1px solid #ccc;
            margin-top: 12px;
        }

    .dialog-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 16px;
        gap: 10px;
    }

    .loading-text {
        text-align: center;
        font-style: italic;
        margin-top: 30px;
    }
</style>

@code {
    private List<LeaveRequestDto> UserLeaves;
    private bool IsLoading = true;
    private string ErrorMessage;
    private bool ShowRemarksDialog = false;
    private int ActionLeaveId;
    private bool IsApproving;
    private string AdminRemarks;
    private HubConnection? hubConnection;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        hubConnection = new HubConnectionBuilder()
            .WithUrl("http://localhost:5051/notificationHub")
            .Build();

        hubConnection.On<string>("ReceiveNotification", (msg) =>
        {
            message = msg;
            InvokeAsync(StateHasChanged);
        });

        await hubConnection.StartAsync();
        await LoadAllLeaves();
    }

    private async Task LoadAllLeaves()
    {
        IsLoading = true;
        try
        {
            UserLeaves = await LeaveRequestService.GetAllLeaveRequestsAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error loading leaves: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadPendingLeaves()
    {
        IsLoading = true;
        try
        {
            UserLeaves = (await LeaveRequestService.GetAllLeaveRequestsAsync())
                .Where(l => l.Status == "Pending").ToList();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error loading pending leaves: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadApprovedLeaves()
    {
        IsLoading = true;
        try
        {
            UserLeaves = (await LeaveRequestService.GetAllLeaveRequestsAsync())
                .Where(l => l.Status == "Approved").ToList();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error loading approved leaves: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadRejectedLeaves()
    {
        IsLoading = true;
        try
        {
            UserLeaves = (await LeaveRequestService.GetAllLeaveRequestsAsync())
                .Where(l => l.Status == "Rejected").ToList();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error loading rejected leaves: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void OnApproveClicked(int leaveId)
    {
        ActionLeaveId = leaveId;
        IsApproving = true;
        AdminRemarks = string.Empty;
        ShowRemarksDialog = true;
    }

    private void OnRejectClicked(int leaveId)
    {
        ActionLeaveId = leaveId;
        IsApproving = false;
        AdminRemarks = string.Empty;
        ShowRemarksDialog = true;
    }

    private void CancelRemarks()
    {
        ShowRemarksDialog = false;
        AdminRemarks = string.Empty;
        ActionLeaveId = 0;
    }

    private async Task SubmitRemarks()
    {
        try
        {
            if (IsApproving)
                await LeaveRequestService.ApproveLeaveAsync(ActionLeaveId, AdminRemarks);
            else
                await LeaveRequestService.RejectLeaveAsync(ActionLeaveId, AdminRemarks);

            ShowRemarksDialog = false;
            AdminRemarks = string.Empty;
            await LoadAllLeaves();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error updating leave: {ex.Message}";
            await JS.InvokeVoidAsync("alert", ErrorMessage);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
            await hubConnection.DisposeAsync();
    }
}