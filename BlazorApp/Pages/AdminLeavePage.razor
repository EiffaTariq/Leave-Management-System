@page "/admin-leaves"
@using BlazorApp.Interface
@using Shared.Entities

@inject ILeaveRequestService LeaveRequestService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<h2 class="page-title">Admin Leave Management</h2>

@if (IsLoading)
{
    <p class="loading-text">Loading leaves...</p>
}
else
{
    <div class="table-container">
        <h4>Leave Requests Overview</h4>

        <table class="styled-table">
            <thead>
                <tr>
                    <th>User ID</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Reason</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var leave in UserLeaves)
                {
                    <tr>
                        <td>@leave.UserId</td>
                        <td>@leave.StartDate.ToString("yyyy-MM-dd")</td>
                        <td>@leave.EndDate.ToString("yyyy-MM-dd")</td>
                        <td>@leave.Reason</td>
                        <td>
                            <span class="badge @leave.Status.ToLower()">
                                @leave.Status
                            </span>
                        </td>
                        <td>
                            @if (leave.Status == "Pending")
                            {
                                <button class="btn success small" @onclick="() => OnApproveClicked(leave.LeaveId)">Approve</button>
                                <button class="btn danger small" @onclick="() => OnRejectClicked(leave.LeaveId)">Reject</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="quick-actions">
            <h4>Quick Filters</h4>
            <button class="btn warning" @onclick="LoadPendingLeaves">Pending</button>
            <button class="btn success" @onclick="LoadApprovedLeaves">Approved</button>
            <button class="btn danger" @onclick="LoadRejectedLeaves">Rejected</button>
        </div>
    </div>
}

@if (ShowRemarksDialog)
{
    <div class="remarks-dialog-overlay">
        <div class="remarks-dialog">
            <h4>@(IsApproving ? "Approve Leave" : "Reject Leave")</h4>
            <textarea @bind="AdminRemarks" rows="4" placeholder="Enter remarks (optional)"></textarea>
            <div class="dialog-actions">
                <button class="btn secondary" @onclick="CancelRemarks">Cancel</button>
                <button class="btn primary" @onclick="SubmitRemarks">Submit</button>
            </div>
        </div>
    </div>
}

