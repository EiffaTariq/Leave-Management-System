@code {
    // private List<LeaveModel> UserLeaves;
    private bool IsLoading = true;
    private string ErrorMessage;
    private string _currentFilter = "Pending";
    private int UserId;

    private List<LeaveRequestDto> UserLeaves { get; set; } = new List<LeaveRequestDto>();
    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;

        var userIdString = await LocalStorage.GetItemAsync<string>("userId");

        if (string.IsNullOrEmpty(userIdString) || !int.TryParse(userIdString, out UserId))
        {
            // Redirect to login if not authenticated
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadLeavesAsync(_currentFilter);
        IsLoading = false;
    }

    private async Task LoadLeavesAsync(string filter)
    {
        ErrorMessage = null;
        IsLoading = true;
        _currentFilter = filter;

        try
        {
            if (filter == "Pending")
            {
                UserLeaves = (await LeaveRequestService.LoadPendingLeaves()).ToList();
            }
            else
            {
                UserLeaves = (await LeaveRequestService.GetApprovedRejectedLeaveRequestsAsync()).ToList();
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error loading leaves: {ex.Message}";
            UserLeaves = new List<LeaveRequestDto>();
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ApproveLeaveAsync(int leaveId)
    {
        await UpdateLeaveStatusAsync(leaveId, "Approved");
    }

    private async Task RejectLeaveAsync(int leaveId)
    {
        await UpdateLeaveStatusAsync(leaveId, "Rejected");
    }

    private async Task UpdateLeaveStatusAsync(int leaveId, string newStatus)
    {
        try
        {
            var response = await LeaveRequestService.UpdateLeaveStatusAsync(leaveId, newStatus);
            if (response.IsSuccessStatusCode)
            {
                // Refresh list after update
                await LoadLeavesAsync(_currentFilter);
            }
            else
            {
                var msg = await response.Content.ReadAsStringAsync();
                ErrorMessage = $"Failed to update status: {msg}";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error updating status: {ex.Message}";
        }
    }

    private async Task LoadPendingLeaves()
    {
        UserLeaves = (await LeaveRequestService.GetUserLeaveRequestsAsync(UserId))
            .Where(l => l.Status == "Pending").ToList();

        StateHasChanged();
    }
}*@


